# --- Base de datos ---
# SQLite (por defecto, sin instalación)
DATABASE_URL=sqlite:///./recoverycare.db

# MariaDB / MySQL (descomenta y ajusta usuario/pass)
# DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3304/recoverycare?charset=utf8mb4

# --- Auth ---
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080  # 7 días

# --- Ollama (chatbot + análisis LLM) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
# Pon ENABLE_LLM_ANALYSIS=false para saltarse el LLM en /meals/record
ENABLE_LLM_ANALYSIS=true

# --- CORS ---
# Coma-separado, o * para todos en desarrollo
CORS_ORIGINS=*
